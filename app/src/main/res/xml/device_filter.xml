<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        USB device filter for BMI machine sensors and Arduino boards.

        IMPORTANT: Entries here control which devices trigger the
        USB_DEVICE_ATTACHED intent (causing the app to be launched/brought
        to front when a USB device is plugged in).

        Do NOT add generic class="0" or class="255" entries here — those
        match virtually every USB device including HID keyboards, mice, and
        2.4 GHz wireless dongles, which caused an infinite crash loop
        (see UsbSerialManager.isNonSerialDevice for the runtime guard).

        Only list specific vendor IDs or serial-class codes that are
        unambiguously BMI / Arduino serial devices.
    -->

    <!-- Arduino (Official & Compatible Microcontrollers) -->
    <usb-device vendor-id="9025" />  <!-- Arduino (0x2341) -->
    <usb-device vendor-id="10755" /> <!-- Arduino.org (0x2A03) -->
    <usb-device vendor-id="6993" />  <!-- SparkFun (0x1B4F) -->
    <usb-device vendor-id="9114" />  <!-- Adafruit (0x239A) -->
    <usb-device vendor-id="5824" />  <!-- PJRC Teensy (0x16C0) -->
    <usb-device vendor-id="1155" />  <!-- STMicroelectronics / STM32 (0x0483) -->
    <usb-device vendor-id="11914" /> <!-- Raspberry Pi Pico RP2040 (0x2E8A) -->
    <usb-device vendor-id="12346" /> <!-- Espressif ESP32 S2/S3 (0x303A) -->

    <!-- WCH CH340 / CH341 / CH9102 / CH347 (Most common Arduino clone chips) -->
    <usb-device vendor-id="6790" /> <!-- WCH (0x1A86) -->

    <!-- FTDI devices -->
    <usb-device vendor-id="1027" /> <!-- FTDI (0x0403) -->

    <!-- Silicon Labs CP210x devices -->
    <usb-device vendor-id="4292" /> <!-- CP210x (0x10C4) -->

    <!-- Prolific PL2303 devices -->
    <usb-device vendor-id="1659" /> <!-- Prolific (0x067B) -->

    <!--
        CDC ACM class filter: USB class 2 (Communications Device Class).
        This is the correct class for genuine serial/Arduino devices.
        Subclass 2 = Abstract Control Model (ACM) — used by all Arduino CDC boards.
        This is safe to include because genuine HID/wireless devices do NOT
        advertise class 2 at the device level.
    -->
    <usb-device class="2" subclass="2" /> <!-- CDC ACM — Arduino Leonardo, Micro, Uno R4, etc. -->
    <usb-device class="2" />              <!-- Generic CDC (composite serial) -->

    <!--
        REMOVED: class="0" (interface-defined class) — was matching wireless USB dongles.
        REMOVED: class="255" (vendor-specific) — was matching non-serial proprietary devices.
        Runtime filtering in UsbSerialManager.isNonSerialDevice() handles edge cases
        without incorrectly triggering the USB_DEVICE_ATTACHED launch for non-BMI devices.
    -->
</resources>
